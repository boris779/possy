# time zone inside the containers (logs, timestamps); e.g. the output of: timedatectl show -p Timezone --value
TZ=Europe/Vienna

# copy to .env and adjust
POSSY_ADMIN_USER=admin
POSSY_ADMIN_PASSWORD=admin
POSSY_ENCRYPTION_KEY=change-me-to-a-long-random-value

# technical user between daemon and service
POSSY_API_USER=possy
POSSY_API_PASSWORD=possy

JIRA_URL=https://jira.example.com/
JIRA_USERNAME=changeme
JIRA_PASSWORD=changeme

# true = write PDFs to ./output instead of printing
POSSY_REDIRECT_TO_FILE=true

CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=admin
CUPS_PRINTER_WHITE=possyWhite
CUPS_PRINTER_PINK=possyPink
CUPS_PRINTER_YELLOW=possyYellow

# Send the note size (e.g. Custom.72x80mm) as media with each print job.
# Set to true if notes come out with blank paper above them because the
# driver's default media is longer (e.g. RP80x200 on generic ESC/POS drivers).
CUPS_SEND_PAGE_SIZE=false
